-- BUCLE PRINCIPAL (AIMBOT & ESP)
RunService.RenderStepped:Connect(function()
    if AimbotActive then
        local target = nil
        local maxDist = AimDistance
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                local head = p.Character.Head
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    local mag = (head.Position - Camera.CFrame.Position).Magnitude
                    if mag <= maxDist then
                        -- Verificación de estructura (Wall Check)
                        local ray = Ray.new(Camera.CFrame.Position, (head.Position - Camera.CFrame.Position).Unit * mag)
                        local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, p.Character})
                        
                        if not hit then
                            target = head
                            maxDist = mag
                        end
                    end
                end
            end
        end
        
        if target and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        end
    end

    -- Lógica X-RAY (ESP con Highlight)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hl = p.Character:FindFirstChild("MetalESP")
            if XRayActive then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "MetalESP"
                    hl.Parent = p.Character
                end
                hl.FillColor = Color3.fromHSV(tick() % 5 / 5, 1, 1) -- Colores neón dinámicos
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            else
                if hl then hl:Destroy() end
            end
        end
    end
end)
